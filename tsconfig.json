{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "declarationDir": "dist",
    "declarationMap": false,
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "stripInternal": true,
    "target": "es2020"
  },
  "include": ["./src/index.ts"]
}
